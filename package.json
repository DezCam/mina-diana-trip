{
  "name": "mina-diana-trip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:maps": "node --experimental-strip-types scripts/generate-maps.mjs",
    "generate:pdfs": "node --experimental-strip-types scripts/generate-pdfs.mjs",
    "verify:pdfs": "node --experimental-strip-types scripts/verify-pdfs.mjs",
    "build:web": "tsc -b && vite build",
    "build": "npm run generate:maps && npm run generate:pdfs && npm run verify:pdfs && npm run build:web",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pngjs": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
